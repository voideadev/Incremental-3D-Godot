; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="incremental_3d"
run/main_scene="uid://dnwwwvqumpbo"
config/features=PackedStringArray("4.7", "GL Compatibility")
run/max_fps=60
config/icon="res://icon.svg"

[display]

window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[physics]

3d/run_on_separate_thread=true
common/max_physics_steps_per_frame=1
common/physics_jitter_fix=0.039
3d/physics_engine="Jolt Physics"
jolt_physics_3d/simulation/velocity_steps=2
jolt_physics_3d/simulation/position_steps=1
jolt_physics_3d/simulation/penetration_slop=0.001
jolt_physics_3d/simulation/sleep_velocity_threshold=0.001
jolt_physics_3d/simulation/sleep_time_threshold=0.01
common/physics_interpolation=true

[rendering]

rendering_device/driver.windows="d3d12"
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
